{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TakeMock",
  "version": "0.1.0",
  "identifier": "com.ashutosh.takemock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm cross-env BROWSER=none pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TakeMock",
        "width": 1280,
        "height": 840,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://images.unsplash.com data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "© 2026 Ashutosh. All rights reserved.",
    "shortDescription": "High-Performance Local-First Exam Suite",
    "longDescription": "TakeMock is a native macOS assessment suite for creating, managing, and taking mock exams. All data stays local on your machine — no servers, no accounts, no internet required.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
